{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalSSH",
  "version": "0.1.0",
  "identifier": "com.localssh.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalSSH",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Local SSH and SFTP manager"
  }
}
